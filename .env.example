# Qwen 3.6 Plus API key via the Bitget hackathon proxy (sponsor LLM).
# Base URL: https://hackathon.bitgetops.com/v1
# Model: qwen3.6-plus
# If not set, the app falls back to curated seed data for demo reliability.
BITGET_QWEN_API_KEY=

# Bitget Agent SDK — public market data does NOT require API keys.
# Trading operations (not used in this demo) would require:
# BITGET_API_KEY=
# BITGET_SECRET_KEY=
# BITGET_PASSPHRASE=
