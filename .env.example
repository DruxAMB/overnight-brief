# Gemini API key for the LLM-powered analyst and synthesizer.
# Get one at https://aistudio.google.com/apikey
# If not set, the app falls back to curated seed data for demo reliability.
GEMINI_API_KEY=

# Bitget Agent SDK — public market data does NOT require API keys.
# Trading operations (not used in this demo) would require:
# BITGET_API_KEY=
# BITGET_SECRET_KEY=
# BITGET_PASSPHRASE=
